# ------------------------------------------------------------------
# Copy this file to .env.local for local dev.
# On Vercel: Project -> Settings -> Environment Variables (add the same keys).
# ------------------------------------------------------------------

# Postgres connection string.
# Local dev: use a Neon branch URL, or run Postgres in Docker.
# Vercel:   the "Vercel Postgres / Neon" integration injects this automatically.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Password for the /admin dashboard (choose anything for the test deploy).
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (any long random string).
ADMIN_SECRET="change-me-too-long-random-string"

# --- Enrichment (optional) ----------------------------------------
# Which provider to use for email -> LinkedIn/company lookup.
#   "domain"   = free, company inferred from the email domain (default)
#   "proxycurl"= paid provider, needs PROXYCURL_API_KEY
#   "scrape"   = experimental LinkedIn scraping (may be blocked on Vercel)
ENRICH_PROVIDER="domain"

# PROXYCURL_API_KEY=""
